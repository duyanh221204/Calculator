<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">24sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_btn_number</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_btn_function</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_btn_operator</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_btn_equals</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="CalcButton.Clear" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_btn_clear</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>
