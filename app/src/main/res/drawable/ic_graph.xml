        android:fillColor="#FFFFFF"
        android:pathData="M 20,18 L 19,16.5 L 20.5,17.5 Z" /> <!-- X axis arrow -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 6,4 L 7.5,5.5 L 5.5,5 Z" /> <!-- Y axis arrow -->

</vector>